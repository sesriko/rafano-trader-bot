# ==========================================
# 6. LOGIKA SIGNAL SCORING ENGINE (0 - 100)
# ==========================================
def calculate_signal_score(vol_ratio, adx_val, rsi14, price_change_pct, is_bb_breakout, net_foreign_val, turnover_mb):
    """
    Sistem Penilaian Kuantitatif (Max 100 Poin):
    1. Volume Spike (Max 25 pt)
    2. Trend Strength ADX (Max 20 pt)
    3. Price Momentum (Max 15 pt)
    4. Bollinger Breakout (Max 10 pt)
    5. RSI Optimization (Max 10 pt)
    6. Foreign/Bandar Flow (Max 10 pt)
    7. Liquidity / Turnover (Max 10 pt)
    """
    score = 0

    # 1. Volume Spike Projection (Max 25 pts)
    if vol_ratio >= 3.0:
        score += 25
    elif vol_ratio >= 2.0:
        score += 20
    elif vol_ratio >= 1.5:
        score += 15

    # 2. ADX Trend Strength (Max 20 pts)
    if adx_val >= 35:
        score += 20
    elif adx_val >= 25:
        score += 15
    elif adx_val >= 20:
        score += 10

    # 3. Price Momentum (Max 15 pts)
    if price_change_pct >= 5.0:
        score += 15
    elif price_change_pct >= 3.0:
        score += 10
    elif price_change_pct >= 2.0:
        score += 5

    # 4. Bollinger Band Breakout (Max 10 pts)
    if is_bb_breakout:
        score += 10

    # 5. RSI Sweet Spot (Max 10 pts)
    if 50 <= rsi14 <= 65:
        score += 10  # Ideal momentum range
    elif 45 <= rsi14 < 50 or 65 < rsi14 < 75:
        score += 5

    # 6. Accumulation Flow (Max 10 pts)
    if net_foreign_val > 1_000_000_000:  # > 1 Miliar
        score += 10
    elif net_foreign_val > 0:
        score += 5

    # 7. Liquidity (Max 10 pts)
    if turnover_mb >= 10.0:  # > 10 Miliar
        score += 10
    elif turnover_mb >= 2.0:
        score += 5

    # Klasifikasi Grade & Visual Progress Bar
    if score >= 85:
        grade = "S (STRONG BUY)"
    elif score >= 70:
        grade = "A (HIGH PROBABILITY)"
    else:
        grade = "B (MODERATE BUY)"

    # Generate Progress Bar Visual (misal: [████████░░] 80/100)
    filled_blocks = int(round(score / 10))
    progress_bar = "█" * filled_blocks + "░" * (10 - filled_blocks)

    return score, grade, progress_bar


# ==========================================
# 7. ANALISIS TEKNIKAL MULTI-INDIKATOR
# ==========================================
def analyze_rafano_signals(ticker, stockbit_token):
    try:
        df = get_stockbit_kline(ticker, stockbit_token)
        if df is None or len(df) < 50:
            return None

        # 1. Trend (Hanya EMA 50) & Volume Analysis
        df['EMA50'] = df['Close'].ewm(span=50, adjust=False).mean()
        df['Vol_Avg20'] = df['Volume'].rolling(window=20).mean()

        # 2. ATR & Swing Low
        df['ATR14'] = ta.volatility.average_true_range(df['High'], df['Low'], df['Close'], window=14)
        df['Resistance20'] = df['High'].rolling(window=20).max()
        df['SwingLow3'] = df['Low'].rolling(window=3).min()

        # 3. Oscillators (RSI, ADX, MACD, BB)
        delta = df['Close'].diff()
        gain = (delta.where(delta > 0, 0)).rolling(window=14).mean()
        loss = (-delta.where(delta < 0, 0)).rolling(window=14).mean()
        df['RSI14'] = 100 - (100 / (1 + (gain / loss)))

        df['ADX'] = ta.trend.adx(df['High'], df['Low'], df['Close'], window=14)
        df['+DI'] = ta.trend.adx_pos(df['High'], df['Low'], df['Close'], window=14)
        df['-DI'] = ta.trend.adx_neg(df['High'], df['Low'], df['Close'], window=14)

        macd = ta.trend.MACD(df['Close'], window_slow=26, window_fast=12, window_sign=9)
        df['MACD'] = macd.macd()
        df['MACD_Signal'] = macd.macd_signal()

        bb = ta.volatility.BollingerBands(df['Close'], window=20, window_dev=2)
        df['BB_Upper'] = bb.bollinger_hband()

        curr = df.iloc[-1]
        prev = df.iloc[-2]

        close_price = float(curr['Close'])
        open_price = float(curr['Open'])
        prev_close = float(prev['Close'])
        ema50 = float(curr['EMA50'])
        volume_realtime = float(curr['Volume'])
        vol_avg = float(curr['Vol_Avg20'])
        rsi14 = float(curr['RSI14'])
        atr14 = float(curr['ATR14'])
        res20 = float(prev['Resistance20'])
        swing_low3 = float(curr['SwingLow3'])

        adx_val = float(curr['ADX'])
        plus_di = float(curr['+DI'])
        minus_di = float(curr['-DI'])
        macd_line = float(curr['MACD'])
        macd_signal = float(curr['MACD_Signal'])
        bb_upper = float(curr['BB_Upper'])

        # --- HITUNG PROYEKSI VOLUME INTRADAY ---
        projected_vol = calculate_projected_volume(volume_realtime)
        volume_ratio = round(projected_vol / vol_avg, 2) if vol_avg > 0 else 1.0

        price_change_pct = round(((close_price - prev_close) / prev_close) * 100, 2)
        turnover_value = close_price * volume_realtime
        turnover_mb = round(turnover_value / 1_000_000_000, 2)

        # --- TRIGGER FILTER RULES ---
        is_uptrend = close_price > ema50
        is_green_candle = close_price > open_price
        is_vol_spike = volume_ratio >= 1.5
        is_momentum = price_change_pct >= 2.0
        is_liquid = turnover_value >= 1_000_000_000
        is_not_overbought = rsi14 < 75
        is_strong_trend = adx_val >= 20 and plus_di > minus_di
        is_macd_bullish = macd_line > macd_signal
        is_bb_breakout = close_price >= bb_upper * 0.98

        if (is_uptrend and is_green_candle and is_vol_spike and is_momentum and 
            is_liquid and is_not_overbought and is_strong_trend and 
            is_macd_bullish and is_bb_breakout):

            flow_text, net_foreign_val = check_stockbit_flow(ticker, stockbit_token)

            # --- KALKULASI SKOR SINYAL ---
            score, grade, progress_bar = calculate_signal_score(
                vol_ratio, adx_val, rsi14, price_change_pct, 
                is_bb_breakout, net_foreign_val, turnover_mb
            )

            # --- LOGIKA STOP LOSS SWING LOW ---
            stop_loss = round(swing_low3 * 0.99, 2)
            max_sl_allowed = round(close_price * 0.95, 2)
            stop_loss = max(stop_loss, max_sl_allowed)
            sl_pct = round(((stop_loss - close_price) / close_price) * 100, 1)

            # --- HITUNG TP1 & TP2 ---
            tp1_atr = close_price + (1.5 * atr14)
            tp1 = round(max(tp1_atr, res20), 2)
            if tp1 <= close_price * 1.03:
                tp1 = round(close_price * 1.04, 2)

            tp2 = round(close_price + (3.0 * atr14), 2)
            tp1_pct = round(((tp1 - close_price) / close_price) * 100, 1)
            tp2_pct = round(((tp2 - close_price) / close_price) * 100, 1)

            return {
                'ticker': ticker,
                'price': close_price,
                'change_pct': price_change_pct,
                'volume_ratio': volume_ratio,
                'turnover_mb': turnover_mb,
                'rsi': round(rsi14, 2),
                'adx': round(adx_val, 2),
                'ema50': round(ema50, 2),
                'bb_upper': round(bb_upper, 2),
                'foreign_status': flow_text,
                'stop_loss': stop_loss,
                'sl_pct': sl_pct,
                'tp1': tp1,
                'tp1_pct': tp1_pct,
                'tp2': tp2,
                'tp2_pct': tp2_pct,
                'atr': round(atr14, 2),
                'score': score,
                'grade': grade,
                'progress_bar': progress_bar
            }
    except Exception:
        pass

    return None


